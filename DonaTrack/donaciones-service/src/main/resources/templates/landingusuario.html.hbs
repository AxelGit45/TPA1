<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>DonaTrack</title>
</head>
<body>
  <h1>DonaTrack</h1>
  <p>Sesión iniciada. {{texto}} (rol: {{rol}}, n° {{id}})</p>

  {{#if variosPerfiles}}
    <form method="POST" action="/cambiar-perfil">
      <input type="submit" value="Cambiar perfil">
    </form>
  {{/if}}

  <form method="POST" action="/logout">
    <input type="submit" value="Cerrar sesión">
  </form>
</body>
</html>