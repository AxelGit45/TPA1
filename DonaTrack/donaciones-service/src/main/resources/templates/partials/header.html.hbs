<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>DonaTrack</title>

    <style>
        body {
            background-color: #f1f5f9;
            color: #1e293b;
            margin: 0;
            font-family: sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar {
            background-color: #1e3a8a;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 25px;
        }

        .navbar a, .navbar a:visited {
            color: #ffffff !important;
            text-decoration: none;
        }

        .navbar a:hover {
            text-decoration: underline;
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            font-weight: bold;
            font-size: 18px;
        }

        .navbar-brand img {
            height: 40px;
            margin-right: 12px;
            border-radius: 6px;
        }

        .navbar-center a {
            margin: 0 15px;
            font-size: 15px;
        }

        .navbar-right a, .navbar-right button {
            font-size: 15px;
        }

        main {
            margin: 30px;
            background-color: #ffffff;
            text-align: center;
            flex: 1;
        }

        .formulario {
            max-width: 480px;
            margin: 0 auto;
            text-align: left;
        }

        .campo {
            margin-bottom: 12px;
        }

        .campo label {
            display: block;
            margin-bottom: 4px;
        }

        .campo input, .campo select {
            width: 100%;
            box-sizing: border-box;
        }
    </style>
</head>
<body>
<header class="navbar">
    <div class="navbar-left">
        <a href="/" class="navbar-brand">
            <img src="/logo.jpg" alt="Logo DonaTrack">
            <span>DonaTrack</span>
        </a>
    </div>

    <nav class="navbar-center">
        <a href="/">🏠 Inicio</a>
        <a href="/mapa-entregas">🗺️ Mapa de Entregas</a>
        {{#if logueado}}
            <a href="/panel">📋 Panel de Acciones</a>
        {{/if}}
    </nav>

    <div class="navbar-right">
        {{#if logueado}}
            <form method="POST" action="/logout" style="display:inline; margin:0;">
                <button type="submit" style="background: none; border: 1px solid white; color: white; padding: 5px 12px; border-radius: 4px; cursor: pointer;">Cerrar sesión</button>
            </form>
        {{else}}
            <a href="/login">Iniciar Sesión / Registrarse</a>
        {{/if}}
    </div>
</header>

<main>