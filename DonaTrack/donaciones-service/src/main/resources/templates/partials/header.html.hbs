<!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <title>DonaTrack</title>

        <style>

            body {
                background-color: #f1f5f9;
                color: #1e293b;
            }

            .navbar {
                background-color: #1e3a8a;
                display: flex;
                align-items: center;
            }

            .navbar a, .navbar a:visited {
                color: #ffffff !important;
                text-decoration: none;
            }

            .navbar-brand {}

            .navbar-brand img {
                height: 40px;
                margin-right: 12px;
                border-radius: 6px;
            }

            .navbar-links a {
                color: #ffffff;
                text-decoration: none;
                margin-right: 12px;
                font-size: 15px;
            }

            .navbar-links a:hover {
                text-decoration: underline;
            }

            main {
                margin: 30px;
                background-color: #ffffff;
                text-align: center;
            }

            ul {
                list-style-position: inside;
            }

            .formulario {
                max-width: 480px;
                margin: 0 auto;
                text-align: left;
            }

            .formulario fieldset {
                margin: 0 0 16px;
            }

            .campo {
                margin-bottom: 12px;
            }

            .campo label {
                display: block;
                margin-bottom: 4px;
            }

            .campo input,
            .campo select {
                width: 100%;
                box-sizing: border-box;
            }

            .ayuda {
                margin: 4px 0 0;
                font-size: 0.9em;
            }

            .opciones {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                gap: 16px;
                margin: 16px 0;
            }

            .opcion {
                width: 220px;
                border: 1px solid #ccc;
                padding: 16px;
            }

        </style>

    </head>
    <body>
    <header class="navbar">
        <a href="/" class="navbar-brand">
            <img src="/logo.jpg" alt="Logo DonaTrack">
            <span>DonaTrack</span>
        </a>
        <nav class="navbar-links">
            <a href="/">Inicio</a>
            <a href="/mapa-entregas">Mapa de Entregas</a>
            {{#if logueado}}
                <form method="POST" action="/logout" style="display:inline; margin:0;">
                    <button type="submit" class="btn-logout">Cerrar sesión</button>
                </form>
            {{else}}
                <a href="/login">Iniciar Sesión/Registrarse</a>
            {{/if}}
        </nav>
    </header>

    <main>