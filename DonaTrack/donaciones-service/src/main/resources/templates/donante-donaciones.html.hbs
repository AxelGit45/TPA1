{{> partials/header}}

<p><a href="/donante">&larr; Volver al Panel de Acciones</a></p>

<h1>Mis Donaciones</h1>

<p>
    <a href="/donante/seguimiento"> Ver entregas en el mapa</a>
</p>

<form method="GET" action="/donante/donaciones">
    <label for="estado">Estado:</label>
    <select id="estado" name="estado">
        <option value="">Todos</option>
         <option value="EN_DEPOSITO">En Depósito</option>
         <option value="ASIGNACION_REALIZADA">Asignada</option>
         <option value="EN_TRASLADO">En Traslado</option>
         <option value="ENTREGADA">Entregada</option>
         <option value="VENCIDA">Vencida</option>
    </select>

       <label for="categoriaId">Categoría:</label>
       <select id="categoriaId" name="categoriaId">
           <option value="">Todas</option>
           {{#each categorias}}
               <option value="{{id}}">{{nombre}}</option>
           {{/each}}
       </select>

       <label for="subcategoriaId">Subcategoría:</label>
       <select id="subcategoriaId" name="subcategoriaId">
           <option value="">Todas</option>
           {{#each subcategorias}}
               <option value="{{id}}">{{nombre}}</option>
           {{/each}}
       </select>

    <button type="submit">Filtrar</button>
    <a href="/donante/donaciones">Limpiar</a>
</form>

{{#if donaciones}}
    <table>
        <thead>
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Descripción</th>
            <th>Categoría</th>
            <th>Entidad Destino</th>
            <th>Estado</th>
            <th>Acción</th>
        </tr>
        </thead>
        <tbody>
        {{#each donaciones}}
            <tr>
                <td>{{this.id}}</td>
                <td>{{this.fecha}}</td>
                <td>{{this.descripcion}}</td>
                <td>{{this.categoria}}</td>
                <td>{{this.entidadDestino}}</td>
                <td>{{this.estado}}</td>
                <td>
                    <a href="/donante/seguimiento">Seguir camión</a>
                </td>
            </tr>
        {{/each}}
        </tbody>
    </table>
{{else}}
    <p>No se encontraron donaciones registradas.</p>
{{/if}}

<script>
  document.getElementById("estado").value = "{{filtroEstado}}";
  document.getElementById("categoriaId").value = "{{filtroCategoriaId}}";
  document.getElementById("subcategoriaId").value = "{{filtroSubcategoriaId}}";
</script>

{{> partials/footer}}