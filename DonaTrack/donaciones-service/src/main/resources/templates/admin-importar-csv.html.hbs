{{> partials/header}}

<h1>Importación Masiva de Donantes (CSV)</h1>

{{#if exito}}
<p>Éxito: {{mensaje}}</p>
{{/if}}

{{#if error}}
<p>Error: {{error}}</p>
{{/if}}

<form method="POST" action="/admin/importar-csv" enctype="multipart/forma-data">
    <label for="archivoCsv">Seleccionar archivo CSV:</label>
    <input type="file" id="archivoCsv" name="archivoCsv" accept=".csv" required>

    <button type="submit">Importar Donantes</button>
</form>

{{> partials/footer}}
