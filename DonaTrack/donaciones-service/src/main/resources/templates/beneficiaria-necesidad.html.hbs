{{> partials/header}}

<p><a href="/entidad">&larr; Volver al panel inicio.</a></p>

<h1>Registrar Nueva Necesidad</h1>

<p>
    <a href="/entidad/donaciones">Ver donaciones asignadas</a>
</p>

{{#if exito}}
    <p>Necesidad registrada correctamente.</p>
{{/if}}

<form method="POST" action="/entidad/necesidades">
    <p>
        <label for="tipo">Tipo de Necesidad:</label><br>
        <select id="tipo" name="tipo" required>
            <option value="RECURRENTE">Recurrente (periódica)</option>
            <option value="EXTRAORDINARIA">Extraordinaria (urgencia puntual)</option>
        </select>
    </p>


         <div class="campo">
                   <label for="categoriaId">Categoría:</label>
                   <select id="categoriaId" name="categoriaId" required>
                       <option value=""> -- Seleccioná una categoría --</option>
                       {{#each categorias}}
                           <option value="{{id}}">{{nombre}}</option>
                       {{/each}}
                   </select>
               </div>



      <div class="campo">
                      <label for="subcategoriaId">Subcategoría:</label>
                      <select id="subcategoriaId" name="subcategoriaId" required disabled>
                          <option value=""> -- Seleccioná una subcategoría --</option>
                          {{#each subcategorias}}
                             {{#each this}}
                                <option value="{{id}}" data-categoria="{{categoriaPadre.nombre}}" hidden>{{nombre}}</option>
                              {{/each}}
                          {{/each}}
                      </select>
                  </div>




        <!-- <label for="subcategoria">Categoría / Bien Necesitado:</label><br>
        <select id="subcategoria" name="subcategoria" required>
            <option value="">-- Seleccionar --</option>
            <option value="Alimentos no perecederos">Alimentos no perecederos</option>
            <option value="Ropa y Abrigo">Ropa y Abrigo</option>
            <option value="Calzado">Calzado</option>
            <option value="Medicamentos">Medicamentos</option>
            <option value="Artículos de Limpieza">Artículos de Limpieza</option>
        </select> -->


    <p>
        <label for="cantidad">Cantidad necesaria (unidades / kg / litros):</label><br>
        <input type="number" id="cantidad" name="cantidad" min="1" required>
    </p>

    <p>
        <label for="fechaLimite">Fecha Límite (si es recurrente):</label><br>
        <input type="date" id="fechaLimite" name="fechaLimite">
    </p>

    <p>
        <label for="descripcion">Descripción detallada:</label><br>
        <textarea id="descripcion" name="descripcion" rows="4" cols="50"></textarea>
    </p>

    <p>
        <button type="submit">Guardar Necesidad</button>
    </p>

</form>

<script>
  const categoria = document.getElementById("categoriaId");

  categoria.addEventListener("change", () => {

     const nombre = categoria.options[categoria.selectedIndex].text;

     const selectSubcategoria = document.getElementById("subcategoriaId");
         selectSubcategoria.value = "";
         selectSubcategoria.disabled = categoria.value === "";
         for (const opcion of selectSubcategoria.querySelectorAll("option[data-categoria]")) {
           opcion.hidden = opcion.dataset.categoria !== nombre;
         }
});

</script>


{{> partials/footer}}
