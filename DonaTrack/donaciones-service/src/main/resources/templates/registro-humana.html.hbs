{{> partials/header}}

<div class="formulario">
  <p><a href="/registro">&larr; Volver</a></p>
  <h1>Registro de persona donante</h1>

  {{#if errores}}
    <div role="alert" style="color: red;">
      <p>Revisá estos datos:</p>
      <ul>
        {{#each errores}}
          <li>{{this}}</li>
        {{/each}}
      </ul>
    </div>
  {{/if}}

  <form method="POST" action="/registro/humana">
    <fieldset>
      <legend>Datos personales</legend>
      <div class="campo">
        <label for="nombre">Nombre</label>
        <input type="text" id="nombre" name="nombre" value="{{nombre}}" autocomplete="given-name" required>
      </div>
      <div class="campo">
        <label for="apellido">Apellido</label>
        <input type="text" id="apellido" name="apellido" value="{{apellido}}" autocomplete="family-name" required>
      </div>
      <div class="campo">
        <label for="edad">Edad</label>
        <input type="number" id="edad" name="edad" value="{{edad}}" min="1" required>
      </div>
      <div class="campo">
        <label for="numeroDeDocumento">Número de documento</label>
        <input type="text" id="numeroDeDocumento" name="numeroDeDocumento" value="{{numeroDeDocumento}}"
               inputmode="numeric" required>
        <p class="ayuda">Solo números, sin puntos.</p>
      </div>
      <div class="campo">
        <label for="genero">Género</label>
        <select id="genero" name="genero" required>
          <option value="Femenino">Femenino</option>
          <option value="Masculino">Masculino</option>
          <option value="No binario">No binario</option>
          <option value="Otro">Otro</option>
          <option value="Prefiero no decir">Prefiero no decir</option>
        </select>
      </div>
      <div class="campo">
        <label for="direccion">Dirección</label>
        <input type="text" id="direccion" name="direccion" value="{{direccion}}" autocomplete="street-address" required>
      </div>
    </fieldset>

    <fieldset>
      <legend>Medios de contacto</legend>
      <div class="campo">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="{{email}}" autocomplete="email" required>
        <p class="ayuda">Es el que vas a usar para iniciar sesión.</p>
      </div>
      <div class="campo">
        <label for="telefono">Teléfono (opcional)</label>
        <input type="tel" id="telefono" name="telefono" value="{{telefono}}" autocomplete="tel">
      </div>
      <div class="campo">
        <label for="whatsapp">WhatsApp (opcional)</label>
        <input type="tel" id="whatsapp" name="whatsapp" value="{{whatsapp}}">
      </div>
      <fieldset>
        <legend>¿Por dónde querés recibir las notificaciones?</legend>
        <label><input type="radio" name="predeterminado" value="EMAIL" checked> Email</label><br>
        <label><input type="radio" name="predeterminado" value="TELEFONO"> Teléfono</label><br>
        <label><input type="radio" name="predeterminado" value="WHATSAPP"> WhatsApp</label><br>
        <p class="ayuda">Si elegís un medio que no cargaste, te avisamos por email.</p>
      </fieldset>
    </fieldset>

    <fieldset>
      <legend>Contraseña</legend>
      <div class="campo">
        <label for="contrasenia">Contraseña</label>
        <input type="password" id="contrasenia" name="contrasenia" minlength="8" pattern="\S+"
               title="Sin espacios" autocomplete="new-password" required>
        <p class="ayuda">Mínimo 8 caracteres, sin espacios.</p>
      </div>
      <div class="campo">
        <label for="confirmacion">Repetir contraseña</label>
        <input type="password" id="confirmacion" name="confirmacion" minlength="8" pattern="\S+"
               title="Sin espacios" autocomplete="new-password" required>
      </div>
    </fieldset>

    <button type="submit">Crear cuenta</button>
  </form>
</div>

{{> partials/footer}}