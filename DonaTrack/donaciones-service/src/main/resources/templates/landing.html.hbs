{{> partials/header}}

<style>
    .contenedor-landing {
        max-width: 850px;
        margin: 30px auto;
        text-align: left;
        padding: 0 15px;
    }

    .centrado {
        text-align: center;
    }

    .fila-tarjetas {
        display: flex;
        gap: 20px;
        margin-top: 30px;
    }

    .tarjeta-info {
        flex: 1;
        border: 1px solid #ccc;
        padding: 20px;
    }
</style>

<div class="contenedor-landing">
    <div class="centrado">
        <img src="/logo.jpg" alt="Logo de Donatrack" width="220">
        <h1>Bienvenido a DonaTrack</h1>
    </div>

    <div class="fila-tarjetas">
        <div class="tarjeta-info">
            <h3>Propósito del Sistema</h3>
            <p>
                DonaTrack es una plataforma transparente diseñada para intermediar, gestionar y realizar el seguimiento en tiempo
                real de donaciones de bienes hacia comedores, hogares y entidades comunitarias.
            </p>
        </div>

        <div class="tarjeta-info">
            <h3>Nuestros Objetivos</h3>
            <ul>
                <li>Trazabilidad total desde el ingreso hasta el destino.</li>
                <li>Asignación inteligente según necesidades reales.</li>
                <li>Acceso abierto para verificar entregas públicas.</li>
            </ul>
        </div>
    </div>
</div>

{{> partials/footer}}