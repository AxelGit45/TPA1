{{> partials/header}}

<h1>Recepción de Donaciones en Almacén</h1>

  <!-- POR TERMINAR -->

<div class="formulario">
  <p><a href="/admin">&larr; Volver</a></p>
  <h1>Registro de donación y sus bienes</h1>
  <!-- POR TERMINAR -->
  <form method="POST" action="/admin/recepcion">
    <fieldset>
      <legend>Datos de la donacion</legend>

      <div class="campo">
        <label for="emailDonante">Email del donante:</label>
        <input type="email" id="emailDonante" name="emailDonante" placeholder="donante@ejemplo.com" required>
      </div>

      <div class="campo">
          <label for="descripcion">Descripción general</label>
          <textarea
            id="descripcion"
            name="descripcion"
            rows="5"
            cols="40"
            maxlength="500"
            placeholder="Escribe aquí una descripción..."
            required
          ></textarea>
      </div>
    </fieldset>

    <button type="submit">Continuar y cargar bienes →</button>
  </form>

