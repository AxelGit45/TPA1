<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Elegir perfil - DonaTrack</title>
</head>
<body>
  <h1>¿Cómo querés ingresar?</h1>

  <div style="display: flex; gap: 16px; flex-wrap: wrap;">
    {{#each opciones}}
      <form method="POST" action="/elegir-perfil" style="border: 1px solid #ccc; padding: 16px; border-radius: 8px;">
        <input type="hidden" name="indice" value="{{indice}}">
        <p>{{texto}}</p>
        <input type="submit" value="Ingresar">
      </form>
    {{/each}}
  </div>

  <form method="POST" action="/logout">
    <input type="submit" value="Cancelar">
  </form>
</body>
</html>