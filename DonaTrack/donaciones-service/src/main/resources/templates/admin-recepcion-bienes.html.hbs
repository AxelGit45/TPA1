{{> partials/header}}

<h2>Recepción de Donaciones en Almacén</h2>

<h3>Paso 2: Bienes de la donación de {{donacion.persona.nombre}} {{donacion.persona.apellido}}{{donacion.persona.razonSocial}}</h3>
<p><strong>Descripción:</strong> {{donacion.descripcion}}</p>

<fieldset style="margin-bottom: 20px;">
    <legend>Bienes cargados hasta ahora</legend>
    {{#if donacion.bienes}}
        <ul>
            {{#each donacion.bienes}}
                <li><strong>{{cantidad}} {{unidad}}</strong> — {{descripcion}} ({{subcategoria.nombre}}){{#if fechaVencimiento}} — vence {{fechaVencimiento}}{{/if}}{{#if estadoUso}} — {{estadoUso}}{{/if}}</li>
            {{/each}}
        </ul>
    {{else}}
        <p>Todavía no agregaste ningún bien a esta donación.</p>
    {{/if}}
</fieldset>

<form method="POST" action="/admin/recepcion/bienes" class="formulario">

    <fieldset>
        <legend>¿Qué dona?</legend>



         <div class="campo">
                   <label for="categoriaId">Categoría:</label>
                   <select id="categoriaId" name="categoriaId" required>
                       <option value=""> -- Seleccioná una categoría --</option>
                       {{#each categorias}}
                           <option value="{{id}}">{{nombre}}</option>
                       {{/each}}
                   </select>
               </div>


      <div class="campo">
                      <label for="subcategoriaId">Subcategoría:</label>
                      <select id="subcategoriaId" name="subcategoriaId" required disabled>
                          <option value=""> -- Seleccioná una subcategoría --</option>
                          {{#each subcategorias}}
                             {{#each this}}
                                <option value="{{id}}" data-categoria="{{categoriaPadre.nombre}}" hidden>{{nombre}}</option>
                              {{/each}}
                          {{/each}}
                      </select>
                  </div>


        <div class="campo">
            <label for="descripcionBien">Descripción del bien:</label>
            <input type="text" id="descripcionBien" name="descripcionBien" placeholder="Ej: Fideos secos 500g" required>
        </div>



        <div class="campo">
            <label for="cantidad">Cantidad:</label>
            <input type="number" id="cantidad" name="cantidad" min="1" required>
        </div>

        <div class="campo">
            <label for="unidad">Unidad:</label>
            <select id="unidad" name="unidad" required>
                <option value="UNIDAD">Unidades</option>
                <option value="KILOGRAMO">Kilogramos</option>
                <option value="LITRO">Litros</option>
            </select>

            <input type="hidden" id="unidadFija" name="unidad" value="UNIDAD" disabled>
        </div>

        <div class="campo" id="campoEstadoUso" style="display: none;">
            <label for="estadoUso">Estado de uso:</label>
            <select id="estadoUso" name="estadoUso">
                <option value="">-- Seleccioná el estado --</option>
                <option value="NUEVO">Nuevo</option>
                <option value="USADO">Usado</option>
            </select>
        </div>


        <div class="campo" id="campoVencimiento" style="display: none;">
            <label for="fechaVencimiento">Fecha de vencimiento:</label>
            <input type="date" id="fechaVencimiento" name="fechaVencimiento">
        </div>
    </fieldset>

    <button type="submit">+ Agregar bien</button>
</form>

<script>
  // Alimentos e higiene muestran vencimiento; libros ,juguetes, mobiliario y vestimenta muestran estado de uso
  const categoria = document.getElementById("categoriaId");

  categoria.addEventListener("change", () => {

     const nombre = categoria.options[categoria.selectedIndex].text;

     const selectSubcategoria = document.getElementById("subcategoriaId");
         selectSubcategoria.value = "";
         selectSubcategoria.disabled = categoria.value === "";
         for (const opcion of selectSubcategoria.querySelectorAll("option[data-categoria]")) {
           opcion.hidden = opcion.dataset.categoria !== nombre;
         }

     const llevaVencimiento = nombre === "ALIMENTOS" || nombre === "HIGIENE";
     const llevaEstadoUso = nombre === "JUGUETES" || nombre === "MOBILIARIO" || nombre === "VESTIMENTA" || nombre === "LIBROS";

    document.getElementById("campoVencimiento").style.display = llevaVencimiento ? "" : "none";
    document.getElementById("fechaVencimiento").required = llevaVencimiento;
    if (!llevaVencimiento) document.getElementById("fechaVencimiento").value = "";

    document.getElementById("campoEstadoUso").style.display = llevaEstadoUso ? "" : "none";
    document.getElementById("estadoUso").required = llevaEstadoUso;
    if (!llevaEstadoUso) document.getElementById("estadoUso").value = "";

   //traba unidades
    const unidad = document.getElementById("unidad");
    if (llevaEstadoUso) unidad.value = "UNIDAD";
    unidad.disabled = llevaEstadoUso;
    document.getElementById("unidadFija").disabled = !llevaEstadoUso;
  });
</script>

<form method="POST" action="/admin/recepcion/finalizar">
    <button type="submit">✓ Finalizar</button>
</form>

{{> partials/footer}}